location /mongoexpress {
  resolver 127.0.0.11 valid=30s ipv6=off;
  set $upstream_mongoexpress https://mongoexpress:443;
  proxy_pass $upstream_mongoexpress;

  # Activer l'auth plugin
  auth_request      /auth/verifier_usager;
  auth_request_set  $auth_x_user_name  $upstream_http_x_user_name;
  proxy_set_header  X-Remote-User $auth_x_user_name;

  proxy_ssl_certificate         /run/secrets/nginx.cert.pem;
  proxy_ssl_certificate_key     /run/secrets/nginx.key.pem;
  proxy_ssl_trusted_certificate /usr/share/nginx/files/certs/millegrille.cert.pem;
  #proxy_ssl_verify       on;
  #proxy_ssl_verify_depth 1;

  proxy_set_header   X-Real-IP         $remote_addr;
  # proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Proto $scheme;
  proxy_max_temp_file_size 0;

  #this is the maximum upload size
  client_max_body_size       1m;
  client_body_buffer_size    128k;

  proxy_connect_timeout      5;
  proxy_send_timeout         20;
  proxy_read_timeout         90;
  proxy_request_buffering    off; # Required for HTTP CLI commands

  # Note: component_base utilise limite taille fichier trop petite pour redmine
  include /etc/nginx/conf.d/component_proxyheaders.include;
  include /etc/nginx/conf.d/component_gzip.include;
}
