[Unit]
Description=MilleGrilles applications
After=network.target
Wants={{INSTANCE_NAME}}-middleware.service

[Service]
Type=simple
WorkingDirectory={{MILLEGRILLES_ROOT}}
EnvironmentFile={{MILLEGRILLES_ROOT}}/config.env
ExecStart=/usr/bin/docker compose -f etc/compose/applications.yml up --remove-orphans
ExecReload=/usr/bin/docker compose -f etc/compose/applications.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f etc/compose/applications.yml down --remove-orphans
Restart=always

[Install]
WantedBy=default.target
