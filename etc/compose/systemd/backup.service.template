[Unit]
Description=Local backup of MilleGrilles {{INSTANCE_NAME}}.
After=network.target

[Service]
Type=oneshot
Nice=3
EnvironmentFile={{MILLEGRILLES_ROOT}}/config.env
ExecStart={{MILLEGRILLES_ROOT}}/bin/backup/millegrilles_backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{INSTANCE_NAME}}_backup

[Install]
WantedBy=default.target
