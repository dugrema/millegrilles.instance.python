[Unit]
Description=MilleGrilles core services
After=network.target
Wants={{INSTANCE_NAME}}-certissuer.service
Wants={{INSTANCE_NAME}}-middleware.service

[Service]
Type=simple
WorkingDirectory={{MILLEGRILLES_ROOT}}
EnvironmentFile={{MILLEGRILLES_ROOT}}/config.env
ExecStart=/usr/bin/docker compose -f etc/compose/coremodules/core.yml up
ExecReload=/usr/bin/docker compose -f etc/compose/coremodules/core.yml up -d
ExecStop=/usr/bin/docker compose -f etc/compose/coremodules/core.yml down
Restart=always

[Install]
WantedBy=default.target
